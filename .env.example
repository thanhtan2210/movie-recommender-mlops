# Copy to .env and fill in; .env is never committed.

# Cloudflare R2 (S3-compatible): raw and processed data
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# MLflow on DagsHub: experiment tracking and model registry.
# Without MLFLOW_TRACKING_URI, runs are tracked locally in mlflow.db.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
